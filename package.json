{
  "name": "@northgate/retail-web",
  "version": "14.31.2",
  "description": "Northgate Online - consumer online banking (MOL)",
  "private": true,
  "engines": {
    "node": "16.20.2",
    "npm": "8.19.4"
  },
  "scripts": {
    "ng": "ng",
    "postinstall": "ngcc --properties es2015 browser module main --first-only --create-ivy-entry-points",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:analyze": "ng build --configuration production --localize=false --stats-json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "lint": "ng lint",
    "e2e": "protractor e2e/protractor.conf.js",
    "i18n:extract": "ng extract-i18n --output-path src/locale --format xlf",
    "sw:verify": "node tools/verify-ngsw.js",
    "audit:report": "npm audit --audit-level=high --json > audit-report.json || true"
  },
  "dependencies": {
    "@angular/animations": "15.2.10",
    "@angular/cdk": "14.2.7",
    "@angular/common": "15.2.10",
    "@angular/compiler": "15.2.10",
    "@angular/core": "15.2.10",
    "@angular/flex-layout": "15.0.0-beta.42",
    "@angular/forms": "15.2.10",
    "@angular/localize": "15.2.10",
    "@angular/material": "14.2.7",
    "@angular/material-moment-adapter": "14.2.7",
    "@angular/platform-browser": "15.2.10",
    "@angular/platform-browser-dynamic": "15.2.10",
    "@angular/router": "15.2.10",
    "@angular/service-worker": "15.2.10",
    "@northgate/canopy-ui": "4.0.0",
    "@northgate/lantern-sdk": "5.0.0",
    "@ngrx/effects": "14.3.3",
    "@ngrx/entity": "14.3.3",
    "@ngrx/router-store": "14.3.3",
    "@ngrx/store": "14.3.3",
    "@ngrx/store-devtools": "14.3.3",
    "@ngx-translate/core": "14.0.0",
    "@ngx-translate/http-loader": "7.0.0",
    "angular-oauth2-oidc": "14.0.1",
    "chart.js": "3.9.1",
    "moment": "2.29.4",
    "ng2-charts": "4.1.1",
    "ngx-cookie-service": "14.0.1",
    "ngx-mask": "14.3.3",
    "rxjs": "7.5.7",
    "tslib": "2.4.1",
    "web-vitals": "3.5.2",
    "zone.js": "0.12.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "15.2.11",
    "@angular-eslint/builder": "15.2.1",
    "@angular-eslint/eslint-plugin": "15.2.1",
    "@angular-eslint/eslint-plugin-template": "15.2.1",
    "@angular-eslint/schematics": "15.2.1",
    "@angular-eslint/template-parser": "15.2.1",
    "@angular/cli": "15.2.11",
    "@angular/compiler-cli": "15.2.10",
    "@northgate/domain-fixtures": "1.6.0",
    "@ngrx/schematics": "14.3.3",
    "@types/jasmine": "4.3.1",
    "@types/node": "16.18.11",
    "@typescript-eslint/eslint-plugin": "5.43.0",
    "@typescript-eslint/parser": "5.43.0",
    "eslint": "8.28.0",
    "express": "4.18.2",
    "jasmine-core": "4.3.0",
    "jasmine-spec-reporter": "7.0.0",
    "karma": "6.4.1",
    "karma-chrome-launcher": "3.1.1",
    "karma-coverage": "2.2.0",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.0.0",
    "karma-junit-reporter": "2.0.1",
    "protractor": "7.0.0",
    "ts-node": "10.9.1",
    "typescript": "4.9.5"
  },
  "overrides": {
    "minimist": "1.2.5",
    "loader-utils": "2.0.3"
  }
}
